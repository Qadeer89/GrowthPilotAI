# Postgres (Neon) — pooled connection for runtime queries, direct/unpooled for Prisma Migrate
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Auth.js
AUTH_SECRET=generate-with-npx-auth-secret

# Redis (BullMQ) — not required until a Phase that uses background jobs; leave unset for now.
REDIS_URL=

# OpenAI (packages/ai provider) — AI Marketing Strategist + Content Studio
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Creative Studio (Phase 3) — local-disk asset storage; swap for a real
# S3-compatible bucket when deploying. Leave unset to default to
# apps/web/.creative-storage (gitignored).
CREATIVE_STORAGE_DIR=
# Font file ffmpeg burns captions with. Leave unset to default to
# C:\Windows\Fonts\arial.ttf (Windows dev default).
CREATIVE_CAPTION_FONT=

# Campaign & Social Publishing (Phase 4) — LinkedIn connector
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn API version header (YYYYMM). Leave unset to default to 202611.
LINKEDIN_API_VERSION=
# Must exactly match the redirect URL registered on the LinkedIn app.
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# Campaign & Social Publishing / Email Marketing (Phase 4/5) -- base URL used
# to build links inside emails (e.g. the unsubscribe link). Leave unset to
# default to http://localhost:3000.
APP_BASE_URL=

# Email Marketing & CRM (Phase 5) -- Resend connector
RESEND_API_KEY=
# Must be on a domain verified in your Resend account.
RESEND_FROM_EMAIL=
# Signing secret from the Resend dashboard's webhook you create pointing at
# /api/webhooks/resend (POST https://api.resend.com/webhooks). Only needed
# once you have a publicly reachable URL to register.
RESEND_WEBHOOK_SECRET=

# Paid Advertising (Phase 6) -- Google Ads connector
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client.
GOOGLE_ADS_REDIRECT_URI=http://localhost:3000/api/auth/google-ads/callback
# From the Google Ads API Center (Manager account required). Starts at
# "Test Account" access -- can only operate on accounts under a separate
# test-manager hierarchy, not a production manager account.
GOOGLE_ADS_DEVELOPER_TOKEN=

# Billing (Paddle) -- "sandbox" until pricing & plans are approved for Live.
PADDLE_ENV=sandbox
# Server-side API key (Paddle dashboard -> Developer Tools -> Authentication).
# Sandbox keys start with pdl_sdbx_, live keys with pdl_live_.
PADDLE_API_KEY=
# Signing secret for the webhook endpoint (Paddle dashboard -> Notifications
# -> your webhook destination -> Signing secret), pointing at
# /api/webhooks/paddle. Required for the webhook route to accept events.
PADDLE_WEBHOOK_SECRET=
# Client-side token (Paddle dashboard -> Developer Tools -> Authentication ->
# Client-side tokens) -- safe to expose to the browser, powers the Checkout overlay.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Comma-separated emails allowed to manage the Plan catalog at
# /dashboard/admin/plans -- there's no platform-admin role, so this is the
# whole authorization check for that page.
BILLING_ADMIN_EMAILS=
