# Postgres (Neon) — pooled connection for runtime queries, direct/unpooled for Prisma Migrate
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Auth.js
AUTH_SECRET=generate-with-npx-auth-secret

# Redis (BullMQ) — not required until a Phase that uses background jobs; leave unset for now.
REDIS_URL=

# OpenAI (packages/ai provider) — AI Marketing Strategist + Content Studio
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Creative Studio (Phase 3) — local-disk asset storage; swap for a real
# S3-compatible bucket when deploying. Leave unset to default to
# apps/web/.creative-storage (gitignored).
CREATIVE_STORAGE_DIR=
# Font file ffmpeg burns captions with. Leave unset to default to
# C:\Windows\Fonts\arial.ttf (Windows dev default).
CREATIVE_CAPTION_FONT=

# Campaign & Social Publishing (Phase 4) — LinkedIn connector
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LinkedIn API version header (YYYYMM). Leave unset to default to 202611.
LINKEDIN_API_VERSION=
# Must exactly match the redirect URL registered on the LinkedIn app.
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback
