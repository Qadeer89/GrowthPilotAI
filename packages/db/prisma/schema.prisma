generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Identity ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships OrganizationMember[]
  sessions    Session[]
  invitationsSent Invitation[] @relation("InvitedBy")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      OrganizationMember[]
  roles        Role[]
  invitations  Invitation[]
  workspaces   Workspace[]
  brands           Brand[]
  auditLogs        AuditLog[]
  usageRecords     UsageRecord[]
  creativeAssets   CreativeAsset[]
  connectedAccounts ConnectedAccount[]
  socialPosts      SocialPost[]
  emailSends        EmailSend[]
  suppressionEntries SuppressionEntry[]
  landingPages      LandingPage[]
  leads             Lead[]
  adCampaigns       AdCampaign[]
  agentTasks        AgentTask[]
  analystQueries    AnalystQuery[]
  optimizationRecommendations OptimizationRecommendation[]
}

// System roles are seeded per organization at creation time (spec Section 3):
// Owner, Admin, Marketing Manager, Content Creator, Analyst, Approver.
model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      OrganizationMember[]
  permissions  RolePermission[]
  invitations  Invitation[]

  @@unique([organizationId, name])
}

// Global catalog of permission keys (e.g. "campaign.create", "ads.approve").
// Granular per spec Section 3 — checked server-side, never only hidden in the UI.
model Permission {
  id          String @id @default(cuid())
  key         String @unique
  description String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@unique([organizationId, userId])
}

model Invitation {
  id              String   @id @default(cuid())
  organizationId  String
  email           String
  roleId          String
  token           String   @unique
  status          String   @default("pending") // pending | accepted | revoked | expired
  invitedByUserId String
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  invitedBy    User         @relation("InvitedBy", fields: [invitedByUserId], references: [id])

  @@index([organizationId])
}

// Our own session/audit record. Auth.js manages the actual login cookie/JWT;
// this table tracks active sessions for admin visibility, independent of
// whatever auth library is swapped in later.
model Session {
  id         String   @id @default(cuid())
  userId     String
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Workspace & Brand ----------

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brands       Brand[]

  @@unique([organizationId, slug])
}

model Brand {
  id               String   @id @default(cuid())
  organizationId   String
  workspaceId      String
  name             String
  website          String?
  industry         String?
  description      String?
  valueProposition String?
  targetCountries  String[]
  targetAudience   String?
  tone             String?
  brandColors      String[]
  languages        String[]
  monthlyBudget    Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  strategies    MarketingStrategy[]
  contentItems  ContentItem[]
  videoProjects VideoProject[]
  campaigns     Campaign[]
  landingPages  LandingPage[]
  adCampaigns   AdCampaign[]
  agentTasks    AgentTask[]
  analystQueries              AnalystQuery[]
  optimizationRecommendations OptimizationRecommendation[]

  @@unique([workspaceId, name])
}

// ---------- Marketing Strategy ----------

model MarketingStrategy {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  brandId        String
  positioning    String
  plan30         String
  plan60         String
  plan90         String
  createdByUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brand           Brand                    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  personas        Persona[]
  messagingPillars MessagingPillar[]
  recommendations StrategyRecommendation[]

  @@index([organizationId])
  @@index([brandId])
}

model Persona {
  id          String   @id @default(cuid())
  strategyId  String
  name        String
  description String
  painPoints  String[]
  goals       String[]

  strategy MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
}

model MessagingPillar {
  id          String @id @default(cuid())
  strategyId  String
  title       String
  description String

  strategy MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)
}

// Each recommendation carries reason/evidence/audience/channel/priority/effort/metric
// per spec Module 1 — never just a bare suggestion.
model StrategyRecommendation {
  id               String   @id @default(cuid())
  strategyId       String
  recommendation   String
  reason           String
  evidenceType     String // "verified" | "assumption" — never presented as fact if assumed
  evidence         String
  targetAudience   String
  suggestedChannel String
  priority         String // "high" | "medium" | "low"
  estimatedEffort  String // "low" | "medium" | "high"
  successMetric    String
  timeframeDays    Int // 30 | 60 | 90

  strategy MarketingStrategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@index([strategyId])
}

// ---------- Content ----------

model ContentItem {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  brandId        String
  contentType    String
  platform       String?
  title          String?
  body           String
  status         String   @default("draft") // draft | in_review | approved | rejected
  createdByUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  brand      Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  versions   ContentVersion[]
  approvals  ContentApproval[]

  @@index([organizationId])
  @@index([brandId])
}

model ContentVersion {
  id            String   @id @default(cuid())
  contentItemId String
  body          String
  createdByUserId String
  createdAt     DateTime @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId])
}

model ContentApproval {
  id            String   @id @default(cuid())
  contentItemId String
  approverId    String
  status        String // approved | rejected
  note          String?
  createdAt     DateTime @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@index([contentItemId])
}

// ---------- Creative Studio ----------

// Every image/audio/video generated by a provider (or assembled locally by
// ffmpeg) is logged here with status and an estimated cost, independent of
// whether it ends up used in a finished video — per spec, a failed or
// in-progress generation is never silently dropped.
model CreativeAsset {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String?
  assetType       String // "image" | "audio" | "video"
  provider        String // "openai" | "ffmpeg-local"
  model           String
  status          String // "completed" | "failed"
  storageKey      String? // filename under the org's storage dir; null if failed
  mimeType        String?
  estimatedCostUsd Float? // derived from published per-unit pricing, not provider-confirmed billing
  failureReason   String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Video workflow: concept -> script -> storyboard -> assets -> voiceover ->
// captions -> rendered. `status` always reflects the furthest stage actually
// completed — a storyboard is never presented as a finished video.
model VideoProject {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String
  brandId         String
  topic           String
  script          String?
  status          String   @default("concept")
  failureReason   String?
  finalVideoAssetId String?
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  scenes VideoScene[]
  socialPosts SocialPost[]

  @@index([organizationId])
  @@index([brandId])
}

model VideoScene {
  id              String   @id @default(cuid())
  videoProjectId  String
  order           Int
  narration       String
  visualPrompt    String
  durationSeconds Float?
  imageAssetId    String?
  audioAssetId    String?

  videoProject VideoProject @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)

  @@index([videoProjectId])
}

// ---------- Integrations ----------

// An org's OAuth connection to a social provider. The row itself is never
// deleted on "disconnect" (status flips instead), so SocialPost history
// always has something to join against.
model ConnectedAccount {
  id                 String   @id @default(cuid())
  organizationId     String
  provider           String // "linkedin" | "google_ads"
  providerAccountId  String // provider's member/user id (LinkedIn: OIDC "sub"; Google Ads: customer ID, digits only)
  managerCustomerId  String? // Google Ads only: the manager (MCC) ID to send as login-customer-id
  displayName        String?
  status             String   @default("connected") // connected | disconnected | expired
  connectedByUserId  String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  oauthToken   OAuthToken?
  socialPosts  SocialPost[]
  adCampaigns  AdCampaign[]

  @@unique([organizationId, provider, providerAccountId])
  @@index([organizationId])
}

// Encrypted at rest (packages/core/src/crypto.ts, AES-256-GCM keyed from
// AUTH_SECRET) per spec Section 17 -- never stored or logged in plaintext.
model OAuthToken {
  id                    String   @id @default(cuid())
  connectedAccountId    String   @unique
  accessTokenEncrypted  String
  refreshTokenEncrypted String? // Google Ads issues a long-lived refresh token; LinkedIn does not.
  scope                 String
  expiresAt             DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
}

// ---------- Campaigns ----------

model Campaign {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String
  brandId         String
  name            String
  objective       String?
  keyMessage      String?
  cta             String?
  status          String   @default("draft") // draft | active | completed
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  brand       Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  socialPosts SocialPost[]
  emailSends  EmailSend[]
  adCampaigns AdCampaign[]

  @@index([organizationId])
  @@index([brandId])
}

// One real publish attempt to one connected social account. idempotencyKey
// means a retry of a row that already succeeded is a safe no-op, never a
// double post. providerPostId/providerPostUrl are only ever set from the
// provider's own response -- never fabricated.
model SocialPost {
  id                 String   @id @default(cuid())
  organizationId     String
  workspaceId        String?
  campaignId         String?
  videoProjectId     String?
  connectedAccountId String
  provider           String // "linkedin"
  body               String
  status             String   @default("queued") // queued | publishing | published | failed
  idempotencyKey     String   @unique
  providerPostId     String?
  providerPostUrl    String?
  failureReason      String?
  attempts           Int      @default(0)
  createdByUserId    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign         Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  videoProject     VideoProject?    @relation(fields: [videoProjectId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([campaignId])
  @@index([videoProjectId])
}

// One real send attempt through the provider. idempotencyKey means a retry
// of a row that already succeeded is a safe no-op. providerMessageId and
// lastEvent are only ever set from the provider's own response/webhook --
// never fabricated. lastEvent mirrors Resend's own event names so the UI
// never shows "delivered" for something that only queued.
model EmailSend {
  id               String    @id @default(cuid())
  organizationId   String
  workspaceId      String?
  campaignId       String?
  toEmail          String
  subject          String
  bodyHtml         String
  status           String    @default("queued") // queued | sent | bounced | complained | failed
  idempotencyKey   String    @unique
  providerMessageId String?
  lastEvent        String? // sent | delivered | bounced | complained | delivery_delayed
  failureReason    String?
  attempts         Int       @default(0)
  createdByUserId  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([campaignId])
  @@index([providerMessageId])
}

// Mirrors Resend's own suppression list (hard bounce / spam complaint /
// unsubscribe) so a send is blocked locally before ever calling the
// provider, not just relying on the provider to silently drop it.
model SuppressionEntry {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  reason         String // bounced | complained | unsubscribed
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
}

model LandingPage {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  brandId        String
  slug           String
  name           String
  headline       String
  body           String
  ctaLabel       String   @default("Get in touch")
  published      Boolean  @default(false)
  createdByUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  leads        Lead[]

  @@unique([organizationId, slug])
}

model Lead {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String
  landingPageId  String?
  name           String?
  email          String
  message        String?
  status         String   @default("new") // new | contacted | qualified | unqualified | converted
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  landingPage  LandingPage? @relation(fields: [landingPageId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([landingPageId])
}

// ---------- Paid Advertising ----------

// A draft or launched ad campaign on an external ad platform. `status` never
// reflects anything the provider hasn't confirmed: it stays "draft" until a
// human approves it (see AdApproval) and "launched" only after the provider
// has actually accepted the create call -- provider*ResourceName fields are
// only ever set from the provider's own response.
model AdCampaign {
  id                                 String   @id @default(cuid())
  organizationId                     String
  workspaceId                        String
  brandId                            String
  connectedAccountId                 String
  campaignId                         String? // optional link to the cross-channel Campaign
  provider                           String // "google_ads"
  name                               String
  dailyBudgetMicros                  BigInt // Google Ads micros: currency units * 1,000,000
  status                             String   @default("draft") // draft | pending_approval | approved | rejected | launched | paused | failed
  providerCampaignBudgetResourceName String?
  providerCampaignResourceName       String?
  providerStatus                     String? // last status read back from the provider (e.g. PAUSED, ENABLED)
  failureReason                      String?
  createdByUserId                    String
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand            Brand            @relation(fields: [brandId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  campaign         Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  approvals        AdApproval[]
  optimizationRecommendations OptimizationRecommendation[]

  @@index([organizationId])
  @@index([brandId])
}

// The approval gate itself (spec Section 21 / Phase 6 exit criteria): a
// campaign can only launch if an AdApproval row with status "approved"
// exists for it. This is enforced in packages/core, never only in the UI.
model AdApproval {
  id               String   @id @default(cuid())
  adCampaignId     String
  approvedByUserId String
  status           String // "approved" | "rejected"
  note             String?
  createdAt        DateTime @default(now())

  adCampaign AdCampaign @relation(fields: [adCampaignId], references: [id], onDelete: Cascade)

  @@index([adCampaignId])
}

// ---------- Autonomous Marketing Agent ----------

// A natural-language request turned into a structured, ordered plan of tool
// calls. `status` tracks real execution progress, never assumed completion.
model AgentTask {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String
  brandId         String
  requestText     String
  status          String   @default("planned") // planned | awaiting_approval | executing | completed | failed
  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  steps        AgentStep[]

  @@index([organizationId])
}

// One planned tool call. requiresApproval is set server-side from the tool
// registry at plan time (never trusted from the AI's output). A step whose
// tool is paid cannot execute until a human approves it -- for
// "launch_ad_campaign" specifically, approving the step is what creates the
// real AdApproval row Phase 6's launchAdCampaign() independently requires,
// so there is no separate bypass path.
model AgentStep {
  id               String   @id @default(cuid())
  agentTaskId      String
  order            Int
  toolName         String
  toolInput        Json
  reason           String?
  requiresApproval Boolean  @default(false)
  status           String   @default("pending") // pending | approved | completed | failed
  result           Json?
  failureReason    String?
  approvedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  agentTask AgentTask @relation(fields: [agentTaskId], references: [id], onDelete: Cascade)

  @@index([agentTaskId])
}

// ---------- Analytics & Intelligence ----------

// A saved Q&A against the AI Marketing Analyst (spec Section 10). `answer` is
// generated only from metrics computed at ask-time in
// packages/core/src/analytics.ts, each already carrying a data_quality flag
// -- the model is never given room to invent a number; anything it can't
// answer from real data lands in the answer's own dataGaps, not a guess.
model AnalystQuery {
  id              String   @id @default(cuid())
  organizationId  String
  workspaceId     String
  brandId         String
  question        String
  answer          Json
  createdByUserId String
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Detect -> Analyze -> Recommend -> Approve -> Execute -> Validate -> Measure
// (Phase 8). `status` only ever advances past "approved" on a real action --
// nothing here can reach "measured" without both a human approval and (for
// an automated type) a real provider call actually completing, same
// discipline as the AdApproval gate. No recommendation type performs a
// financial change without going through this approval step first.
model OptimizationRecommendation {
  id                  String   @id @default(cuid())
  organizationId      String
  workspaceId         String
  brandId             String
  relatedAdCampaignId String?
  type                String // "pause_unmonitored_spend" | "review_failed_launch"
  rationale           String
  dataQuality         String // "provider_reported" | "estimated" | "attributed" | "missing"
  proposedChange      Json?
  status              String   @default("awaiting_approval") // awaiting_approval | approved | executing | measured | rejected | failed
  measurement         Json?
  failureReason       String?
  approvedByUserId    String?
  createdByUserId     String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brand             Brand        @relation(fields: [brandId], references: [id], onDelete: Cascade)
  relatedAdCampaign AdCampaign?  @relation(fields: [relatedAdCampaignId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([relatedAdCampaignId])
}

// ---------- Platform ----------

// Every AI provider call records tokens here (spec Section 19) — usage
// tracking exists from day one, not bolted on when billing ships.
model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String?
  feature        String // "strategy_generation" | "content_generation" | ...
  provider       String // "openai"
  model          String
  inputTokens    Int
  outputTokens   Int
  createdByUserId String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Append-only audit trail (spec Section 17/20). Every sensitive action writes
// here — role changes, invitations, org/workspace creation, future approvals.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         String
  targetType     String?
  targetId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([action])
}
